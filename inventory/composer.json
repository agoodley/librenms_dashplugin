{
    "name": "agoodley/librenms-inventory-plugin",
    "description": "LibreNMS plugin: inventory reports across the network from what LibreNMS already collects: models and software versions, device and module serial numbers, optics by type, vendor, model and wavelength, a serial number search, CSV exports and a panel on each device page",
    "keywords": [
        "librenms",
        "plugin",
        "inventory",
        "serial-numbers",
        "transceivers"
    ],
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "agoodley"
        }
    ],
    "autoload": {
        "psr-4": {
            "Agoodley\\LibrenmsInventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agoodley\\LibrenmsInventory\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "librenms/plugin-interfaces": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agoodley\\LibrenmsInventory\\InventoryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
