# Based on LibreNMS 26.10.0 (dist/librenms-scheduler.service); kept with the trusted installer.
[Unit]
Description=LibreNMS Scheduler

[Service]
Type=oneshot
StandardOutput=null
StandardError=null
WorkingDirectory=/opt/librenms/
ExecStart=/usr/bin/env php artisan schedule:run --no-ansi --no-interaction
User=librenms
Group=librenms
