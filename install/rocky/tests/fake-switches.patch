+# phase 4 test-lab patch: spanning tree bridge priorities per VLAN (PVST+), kept on the switch's configuration
+def stp_priorities(switch_configuration):
+    """VLAN number => bridge priority set with "spanning-tree vlan <list> priority <n>" (the others have the default)."""
+    priorities = getattr(switch_configuration, "lab_stp_priorities", None)
+    if priorities is None:
+        priorities = {}
+        switch_configuration.lab_stp_priorities = priorities
+    return priorities
+
+
+def parse_stp_priority(args, needs_value):
+    """(VLANs, priority) of the arguments of "spanning-tree vlan <list> priority <n>"; (None, None) when they are not that."""
+    args = list(args)
+    if len(args) < 3 or args[0] != "vlan" or len(args[2]) < 2 or not "priority".startswith(args[2]):
+        return None, None
+    if needs_value and len(args) != 4 or not needs_value and len(args) not in (3, 4):
+        return None, None
+    if not re.match(r"^\d+(-\d+)?(,\d+(-\d+)?)*$", args[1]):
+        return None, None
+    vlans = []
+    for part in args[1].split(","):
+        start, _, stop = part.partition("-")
+        start, stop = int(start), int(stop or start)
+        if start < 1 or stop > 4094 or start > stop:
+            return None, None
+        vlans += range(start, stop + 1)
+    priority = None
+    if len(args) == 4:
+        if not re.match(r"^\d+$", args[3]):
+            return None, None
+        priority = int(args[3])
+    return vlans, priority
+
+
+def stp_priority_lines(switch_configuration):
+    """The "spanning-tree vlan <ranges> priority <n>" lines of show running-config, one per priority, as IOS groups them."""
+    by_priority = {}
+    for vlan, priority in stp_priorities(switch_configuration).items():
+        by_priority.setdefault(priority, []).append(vlan)
+    lines = []
+    for priority in sorted(by_priority):
+        vlans = sorted(by_priority[priority])
+        ranges = []
+        for vlan in vlans:
+            if ranges and ranges[-1][1] == vlan - 1:
+                ranges[-1][1] = vlan
+            else:
+                ranges.append([vlan, vlan])
+        text = ",".join(str(a) if a == b else ("%s,%s" % (a, b) if b == a + 1 else "%s-%s" % (a, b)) for a, b in ranges)
+        lines.append("spanning-tree vlan %s priority %s" % (text, priority))
+    return lines
