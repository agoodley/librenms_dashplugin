+    def do_spanning_tree(self, *args):
+        # phase 4 test-lab patch: the bridge priority per VLAN (PVST+), as IOS takes it,
+        # "spanning-tree vlan <list> priority <0-61440, a multiple of 4096>"; show running-config lists it
