{
    "name": "agoodley/librenms-topology-plugin",
    "description": "LibreNMS plugin: Layer 2, Layer 3 and site maps with saved views and exports, spanning tree, link, routing, redundancy and coverage diagnostics, a host locator, path trace, rollout planner, device dependencies and a topology history",
    "keywords": [
        "librenms",
        "plugin",
        "topology",
        "lldp",
        "cdp",
        "spanning-tree",
        "vlan",
        "redundancy",
        "stp",
        "network-map"
    ],
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "agoodley"
        }
    ],
    "autoload": {
        "psr-4": {
            "Agoodley\\LibrenmsTopology\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agoodley\\LibrenmsTopology\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "librenms/plugin-interfaces": "^1.0"
    },
    "require-dev": {
        "nesbot/carbon": "^2.72|^3.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agoodley\\LibrenmsTopology\\TopologyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
